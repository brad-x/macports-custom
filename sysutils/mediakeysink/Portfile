# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        brad-x mediakeysink 1.0 v
github.tarball_from releases

categories          sysutils
platforms           {darwin >= 22}
maintainers         nomaintainer
license             Restrictive

description         Stops headset and keyboard play buttons from launching Apple Music

long_description    MediaKeySink claims Now Playing in the background and ignores media \
                    commands, so headset and keyboard play buttons do nothing (instead of \
                    launching Apple Music) unless another app is playing.

checksums           rmd160  9150f02112251a2414008c64c0c9c83e907674be \
                    sha256  29a5702af092f9768c060ab916d3c6275878c6b9e03fc67ef521231237fa5c29 \
                    size    2360

use_xcode           yes
use_configure       no
universal_variant   no

set app_bundle      ${worksrcpath}/MediaKeySink.app

build {
    xinstall -d ${app_bundle}/Contents/MacOS
    system -W ${worksrcpath} "/usr/bin/swiftc -O -o ${app_bundle}/Contents/MacOS/MediaKeySink main.swift"
    xinstall -m 0644 ${worksrcpath}/Info.plist ${app_bundle}/Contents/Info.plist
    system "/usr/bin/codesign --force --sign - ${app_bundle}"
}

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${app_bundle} ${destroot}${applications_dir}
}

notes "
MediaKeySink runs in the background with no Dock or menu bar icon.
Start it once after installing (it adds itself to Login Items):

    open ${applications_dir}/MediaKeySink.app

After an upgrade, restart it:

    pkill -x MediaKeySink; open ${applications_dir}/MediaKeySink.app
"
